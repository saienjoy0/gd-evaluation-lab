{
  "contract_version": "0.1",
  "session_id": "exercise-b-low-001",
  "scenario_id": "candidate-assessment-b-stakeholder-conflict",
  "scenario_version": "candidate-assessment-b-v0.1",
  "started_at": "2026-08-05T10:00:00Z",
  "ended_at": "2026-08-05T10:15:00Z",
  "participants": [
    {
      "participant_id": "candidate_b_low",
