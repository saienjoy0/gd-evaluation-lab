{"rubric_id":"ai-participant","version":"ai-participant-v0.1","status":"draft","purpose":"AI参加者とGDシステムが、利用者へ公平で自然な評価機会を提供したかを判定する。","dimensions":[{"id":"goal_progression","label":"目標進行","definition":"GDの目的と必要な議論段階へ自然に進めたか。","scale":{"min":1,"max":5}},{"id":"responsiveness","label":"ユーザー発言への応答","definition":"ユーザーの質問・懸念・提案へ直接応答したか。","scale":{"min":1,"max":5}},{"id":"user_agency","label":"ユーザー主体性の確保","definition":"ユーザーへ十分な発言・選択・修正機会を与えたか。","scale":{"min":1,"max":5}},{"id":"role_believability","label":"役割の一貫性","definition":"各AI参加者の役割・立場・知識制約を一貫して維持したか。","scale":{"min":1,"max":5}},{"id":"discussion_coherence","label":"議論の一貫性","definition":"前提・制約・過去発言を保持し、矛盾なく議論したか。","scale":{"min":1,"max":5}},{"id":"novelty_and_repetition","label":"新規性と重複抑制","definition":"既出内容を不必要に繰り返さず、新しい価値を追加したか。","scale":{"min":1,"max":5}},{"id":"consensus_quality","label":"合意形成の品質","definition":"比較・反対意見・実行条件を扱い、妥当な収束を支援したか。","scale":{"min":1,"max":5}},{"id":"natural_pacing","label":"自然なテンポ","definition":"発言順、間、長さ、連続発言が自然で、ユーザーを圧迫しなかったか。","scale":{"min":1,"max":5}}],"deterministic_rules":[{"id":"AI-Q-001","name":"ai_committed_while_user_speaking","severity":"critical","affected_dimensions":["user_agency","natural_pacing"]},{"id":"AI-Q-002","name":"stale_generation_committed","severity":"critical","affected_dimensions":["discussion_coherence","responsiveness"]},{"id":"AI-Q-003","name":"stale_generation_not_discarded","severity":"major","affected_dimensions":["discussion_coherence"]},{"id":"AI-Q-004","name":"ai_burst_limit_exceeded","severity":"major","affected_dimensions":["user_agency","natural_pacing"]},{"id":"AI-Q-005","name":"same_agent_three_consecutive","severity":"major","affected_dimensions":["role_believability","natural_pacing"]},{"id":"AI-Q-006","name":"phase_advanced_before_user_response","severity":"critical","affected_dimensions":["user_agency","goal_progression"]},{"id":"AI-Q-007","name":"required_move_missing","severity":"major","affected_dimensions":["goal_progression","consensus_quality"]},{"id":"AI-Q-008","name":"forbidden_move_committed","severity":"critical","affected_dimensions":["goal_progression","discussion_coherence"]},{"id":"AI-Q-009","name":"user_opportunity_missing","severity":"critical","affected_dimensions":["user_agency"]},{"id":"AI-Q-010","name":"scenario_constraint_forgotten","severity":"major","affected_dimensions":["discussion_coherence","consensus_quality"]}],"gate_policy":{"critical_violation_status":"fail","major_violation_threshold":2,"affected_candidate_dimensions_must_be_ne":true}}
