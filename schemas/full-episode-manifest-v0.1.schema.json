{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gd-evaluation/schemas/full-episode-manifest-v0.1.schema.json",
  "title": "Full Episode Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "manifest_version",
    "case_id",
    "exercise_id",
    "state",
    "runner_version",
    "artifacts"
  ],
  "properties": {
    "contract_version": {"const": "0.1"},
    "manifest_version": {"const": "full-episode-manifest-v0.1"},
    "case_id": {"type": "string", "minLength": 1},
    "exercise_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["high", "medium", "low", "system_failure"]},
    "runner_version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role", "depends_on"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {
            "enum": ["source", "human_authored", "generated", "test_oracle"]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
