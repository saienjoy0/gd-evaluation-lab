{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gd-evaluation/schemas/evaluation-result-v0.1.schema.json",
  "title": "GD Evaluation Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "session_id", "status", "ai_quality", "candidate_dimensions", "display_groups", "version_info", "review_status"],
  "$defs": {
    "candidateDimensionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "score", "confidence", "evidence_message_ids", "positive_behavior", "missing_behavior", "improvement", "not_evaluable_reason", "question_results"],
      "properties": {
        "dimension": {
          "enum": [
            "issue_framing",
            "logical_reasoning",
            "listening_and_response",
            "valuable_contribution",
            "collaboration_and_relationship",
            "decision_and_consensus",
            "process_and_time_management"
          ]
        },
        "score": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 4},
            {"const": "NE"}
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_message_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "positive_behavior": {"type": "string"},
        "missing_behavior": {"type": "string"},
        "improvement": {"type": "string"},
        "not_evaluable_reason": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "detail"],
              "properties": {
                "code": {
                  "enum": [
                    "INSUFFICIENT_OPPORTUNITY",
                    "AI_QUALITY_FAILURE",
                    "TRANSCRIPT_INCOMPLETE",
                    "EVENT_ORDER_INVALID",
                    "SYSTEM_ERROR",
                    "SCENARIO_CONDITION_UNFAIR",
                    "INSUFFICIENT_EVIDENCE",
                    "JUDGE_FAILURE"
                  ]
                },
                "detail": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "question_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question_id", "probabilities", "evidence_message_ids"],
            "properties": {
              "question_id": {"type": "string", "minLength": 1},
              "probabilities": {
                "type": "object",
                "additionalProperties": false,
                "required": ["not_observed", "partially_observed", "observed", "strongly_observed"],
                "properties": {
                  "not_observed": {"type": "number", "minimum": 0, "maximum": 1},
                  "partially_observed": {"type": "number", "minimum": 0, "maximum": 1},
                  "observed": {"type": "number", "minimum": 0, "maximum": 1},
                  "strongly_observed": {"type": "number", "minimum": 0, "maximum": 1}
                }
              },
              "evidence_message_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"score": {"const": "NE"}}, "required": ["score"]},
          "then": {
            "properties": {
              "not_evaluable_reason": {"type": "object"},
              "evidence_message_ids": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"score": {"type": "integer"}}, "required": ["score"]},
          "then": {
            "properties": {
              "not_evaluable_reason": {"type": "null"},
              "evidence_message_ids": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"score": {"const": 4}}, "required": ["score"]},
          "then": {"properties": {"evidence_message_ids": {"minItems": 2}}}
        }
      ]
    }
  },
  "properties": {
    "contract_version": {"const": "0.1"},
    "session_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "partial", "not_evaluable", "failed"]},
    "ai_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "violations", "dimension_scores"],
      "properties": {
        "status": {"enum": ["pass", "warn", "fail"]},
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "severity", "message_ids", "affected_candidate_dimensions"],
            "properties": {
              "rule_id": {"type": "string"},
              "severity": {"enum": ["info", "minor", "major", "critical"]},
              "message_ids": {"type": "array", "items": {"type": "string"}},
              "affected_candidate_dimensions": {
                "type": "array",
                "items": {
                  "enum": [
                    "issue_framing",
                    "logical_reasoning",
                    "listening_and_response",
                    "valuable_contribution",
                    "collaboration_and_relationship",
                    "decision_and_consensus",
                    "process_and_time_management"
                  ]
                }
              }
            }
          }
        },
        "dimension_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal_progression", "responsiveness", "user_agency", "role_believability", "discussion_coherence", "novelty_and_repetition", "consensus_quality", "natural_pacing"],
          "properties": {
            "goal_progression": {"type": "number", "minimum": 1, "maximum": 5},
            "responsiveness": {"type": "number", "minimum": 1, "maximum": 5},
            "user_agency": {"type": "number", "minimum": 1, "maximum": 5},
            "role_believability": {"type": "number", "minimum": 1, "maximum": 5},
            "discussion_coherence": {"type": "number", "minimum": 1, "maximum": 5},
            "novelty_and_repetition": {"type": "number", "minimum": 1, "maximum": 5},
            "consensus_quality": {"type": "number", "minimum": 1, "maximum": 5},
            "natural_pacing": {"type": "number", "minimum": 1, "maximum": 5}
          }
        }
      }
    },
    "candidate_dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/candidateDimensionEntry"},
      "allOf": [
        {"contains": {"properties": {"dimension": {"const": "issue_framing"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "logical_reasoning"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "listening_and_response"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "valuable_contribution"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "collaboration_and_relationship"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "decision_and_consensus"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension": {"const": "process_and_time_management"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "display_groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thinking", "collaboration", "progress"],
      "properties": {
        "thinking": {"type": "object", "additionalProperties": false, "required": ["score", "summary"], "properties": {"score": {"oneOf": [{"type": "number", "minimum": 1, "maximum": 4}, {"const": "NE"}]}, "summary": {"type": "string"}}},
        "collaboration": {"type": "object", "additionalProperties": false, "required": ["score", "summary"], "properties": {"score": {"oneOf": [{"type": "number", "minimum": 1, "maximum": 4}, {"const": "NE"}]}, "summary": {"type": "string"}}},
        "progress": {"type": "object", "additionalProperties": false, "required": ["score", "summary"], "properties": {"score": {"oneOf": [{"type": "number", "minimum": 1, "maximum": 4}, {"const": "NE"}]}, "summary": {"type": "string"}}}
      }
    },
    "version_info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_version", "ai_quality_rubric_version", "scenario_version", "orchestrator_version", "prompt_version", "judge_model", "judge_version", "deterministic_evaluator_version", "transcript_hash"],
      "properties": {
        "rubric_version": {"type": "string", "minLength": 1},
        "ai_quality_rubric_version": {"type": "string", "minLength": 1},
        "scenario_version": {"type": "string", "minLength": 1},
        "orchestrator_version": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "judge_model": {"type": "string", "minLength": 1},
        "judge_version": {"type": "string", "minLength": 1},
        "deterministic_evaluator_version": {"type": "string", "minLength": 1},
        "transcript_hash": {"type": "string", "minLength": 1}
      }
    },
    "review_status": {"enum": ["not_required", "queued", "in_review", "completed"]},
    "legacy_evaluation": {"type": ["object", "null"]},
    "evaluation_disagreement": {"type": ["object", "null"]}
  }
}
